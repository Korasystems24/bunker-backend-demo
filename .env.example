# ── База данных (PostgreSQL + TimescaleDB) ─────────────────────────────────
# DSN для SQLAlchemy async-драйвера (asyncpg). Заполни своими значениями!
BUNKER_DATABASE__URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<dbname>
# BUNKER_DATABASE__ECHO=false

# ── API ─────────────────────────────────────────────────────────────────────
# Origin'ы фронта для CORS (явный allowlist, не '*')
BUNKER_API__CORS_ORIGINS=["http://localhost:5173"]
# Токен edge-устройств для POST-ручек (X-API-Key). Заполнить своим значением!
BUNKER_API__EDGE_API_KEY=<generate-random-token>

# ── Логи ────────────────────────────────────────────────────────────────────
BUNKER_LOGGING__LEVEL=INFO
BUNKER_LOGGING__JSON=false

# ── Docker Compose (значения по умолчанию можно не задавать) ───────────────
# POSTGRES_USER=bunker
# POSTGRES_PASSWORD=bunker
# POSTGRES_DB=bunker
# POSTGRES_PORT=5432
# API_PORT=8000