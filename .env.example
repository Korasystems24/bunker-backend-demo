# ── База данных (PostgreSQL + TimescaleDB) ─────────────────────────────────
# DSN для SQLAlchemy async-драйвера (asyncpg). Заполни своими значениями!
BUNKER_DATABASE__URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<dbname>
# BUNKER_DATABASE__ECHO=false

# ── API ─────────────────────────────────────────────────────────────────────
BUNKER_ENVIRONMENT=development
# Origin'ы фронта для CORS (явный allowlist, не '*').
# На сервере — реальный origin фронта, например http://<публичный-IP>:5173
BUNKER_API__CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Bearer-токен edge-устройств (заголовок Authorization: Bearer <token>,
# как шлёт EdgePC). Должен совпадать с DISPATCH__HTTP__AUTH_TOKEN агента.
BUNKER_API__EDGE_AUTH_TOKEN=<generate-random-token>
# Порог тишины узла edge (dead-man), секунды.
# BUNKER_API__EDGE_STALE_AFTER_SEC=300
# Интервал опроса SilenceMonitor (фоновая задача)
# BUNKER_API__SILENCE_POLL_INTERVAL_SEC=30
# Предупреждать о расхождении часов EdgePC, секунды
# BUNKER_API__EDGE_CLOCK_DRIFT_WARN_SEC=60

# ── Каталог ─────────────────────────────────────────────────────────────────
# BUNKER_CATALOG__PATH=catalog/bunkers.json

# ── Buildup (эвристика v1; пороги меняются без правки кода) ────────────────
# BUNKER_BUILDUP__OUTER_POSITION_THRESHOLD=6
# BUNKER_BUILDUP__DEVIATION_THRESHOLD_M=0.35

# ── Логи ────────────────────────────────────────────────────────────────────
BUNKER_LOGGING__LEVEL=INFO
BUNKER_LOGGING__JSON_LOGS=false

# ── Docker Compose ──────────────────────────────────────────────────────────
# На сервере задайте сильный POSTGRES_PASSWORD (не дефолт bunker).
# POSTGRES_USER=bunker
# POSTGRES_PASSWORD=bunker
# POSTGRES_DB=bunker
# POSTGRES_PORT=5432
# API_PORT=8000